capability generate-python-library-report
feature generate-python-library-report sha256:79a7c9c05e2dd5aca54830a25b0aed954c3a3e9bb59c5c92f2fe4f50c7a0c73e
intent: Generate the entire Python standard library provider report from https://docs.python.org/3/library/index.html in one invocation. Use the estate web scraper through the batch proposal capability. List every indexed module, design typed input and output contracts and five ranked use cases for each current module, identify removals, and publish one Markdown artifact. Supply only the reference URL. Reuses public source-linked batches retained in the last 24 hours.
outcome: A Markdown artifact digest with COMPLETE or PARTIAL and exact module coverage, verified against the official inventory at publication.
inquiry: Create the full Python standard library report with provider bindings, input/output contracts and the top five use cases for each library.
inquiry: Use the web scraper to report on every Python standard library module as a potential estate provider.
inquiry: Finish the Python standard library provider report from the documentation URL.
input contract generate-python-library-report-request.v1 {"type":"object","additionalProperties":false,"properties":{"url":{"type":"string","enum":["https://docs.python.org/3/library/index.html","https://docs.python.org/3/py-modindex.html"]}}}
output contract python-library-report.v1 {"type":"object","additionalProperties":true,"required":["contractId","status"],"properties":{"contractId":{"const":"python-library-report.v1"},"status":{"enum":["COMPLETE","PARTIAL"]},"contentDigest":{"type":"string"},"proposals":{"type":"integer"},"missingCount":{"type":"integer"}}}
cli display outcome as json
scenario generate-python-library-report root terminal
variants: COMPLETE:success,PARTIAL:failure
given: the official Python standard library reference URL and public research batches retained within the last twenty-four hours
when: OV3 inventories the modules, researches missing current modules in retained batches, rechecks the official inventory and publishes the Markdown
then: OV3 returns a digest and reports complete only when every current module has a sourced proposal with contracts and five ranked uses
operation generate-python-library-report.inventory uses provider read-python-library-sources
config: {"limit":400}
operation generate-python-library-report.plan uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @job uniqueidentifier=NULL, @scope nvarchar(250)=NULL, @hash nvarchar(100)=JSON_VALUE(@input,'$.moduleIndexHash'), @total int=TRY_CONVERT(int,JSON_VALUE(@input,'$.indexedCount')), @since datetime2=DATEADD(hour,-24,SYSUTCDATETIME()); DECLARE @turns TABLE (id uniqueidentifier, seq bigint, result nvarchar(max), cap nvarchar(100)); DECLARE @inventory TABLE (name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, url nvarchar(900), section nvarchar(250), removed bit, summary nvarchar(1500)); INSERT @inventory SELECT name,url,section,removed,summary FROM OPENJSON(@input,'$.modules') WITH (name nvarchar(250) '$.module',url nvarchar(900) '$.documentationUrl',section nvarchar(250),removed bit,summary nvarchar(1500)); IF ISNULL(JSON_VALUE(@input,'$.status'),'')<>'LISTED' OR @hash IS NULL OR ISNULL(@total,0)=0 OR @total<>(SELECT COUNT(*) FROM @inventory) THROW 51000,'PYTHON_REPORT_SOURCE_INVENTORY_INCOMPLETE',1; DECLARE @entries TABLE(name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, proposal nvarchar(max)); INSERT @turns SELECT @job,a.content_artifact_pk,p.value,'propose-python-library-binding' FROM model.content_artifact a JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) b CROSS APPLY OPENJSON(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.entries') p WHERE a.artifact_kind=N'public-python-library-research-batch.v1' AND a.registered_date>=@since AND JSON_VALUE(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.contractId')='python-library-proposals-batch.v1'; INSERT @entries SELECT m.name,p.result FROM @inventory m CROSS APPLY ( SELECT TOP (1) result FROM @turns t WHERE t.cap='propose-python-library-binding' AND JSON_VALUE(result,'$.contractId')='python-library-binding-proposal.v1' AND JSON_VALUE(result,'$.status')='PROPOSED' AND JSON_VALUE(result,'$.source.module') COLLATE Latin1_General_100_BIN2=m.name AND JSON_VALUE(result,'$.source.documentationUrl')=m.url AND JSON_VALUE(result,'$.source.responseBodyHash') LIKE 'sha256:%' AND JSON_QUERY(result,'$.inputContract') IS NOT NULL AND JSON_QUERY(result,'$.outputContract') IS NOT NULL AND (SELECT COUNT(DISTINCT TRIM(value)) FROM OPENJSON(result,'$.useCases') WHERE type=1 AND NULLIF(TRIM(value),'') IS NOT NULL)=5 ORDER BY t.seq DESC) p WHERE m.removed=0; DECLARE @limit int=COALESCE(TRY_CONVERT(int,TRY_CONVERT(float,JSON_VALUE(@input,'$.maxModules'))),400); IF @limit NOT BETWEEN 1 AND 400 THROW 51000,'PYTHON_REPORT_BATCH_BOUND_INVALID',1; DECLARE @work TABLE(ord int, url nvarchar(900)); INSERT @work SELECT TOP (@limit) ROW_NUMBER() OVER (ORDER BY m.name),m.url FROM @inventory m LEFT JOIN @entries e ON m.name=e.name WHERE m.removed=0 AND e.name IS NULL ORDER BY m.name; DECLARE @batches nvarchar(max)=(SELECT 'research-python-library-batch' AS executionTarget,'sidefx:capabilities' AS executionNamespace, 'research-python-library-batch' AS executionScenario,'json' AS inputType, JSON_QUERY((SELECT JSON_QUERY((SELECT w.url FROM @work w WHERE (w.ord-1)/5=g.grp ORDER BY w.ord FOR JSON PATH)) AS sources FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) AS dispatchRequest FROM (SELECT DISTINCT (ord-1)/5 AS grp FROM @work) g ORDER BY g.grp FOR JSON PATH); SELECT (SELECT JSON_QUERY(COALESCE(@batches,'[]')) AS batches FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from generate-python-library-report.inventory $
operation generate-python-library-report.research kind for-each port generate-python-library-report-research over result.value.batches max 80
operation generate-python-library-report.verify-inventory uses provider read-python-library-sources
config: {"limit":400}
operation generate-python-library-report.assemble uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @job uniqueidentifier=NULL, @scope nvarchar(250)=NULL, @hash nvarchar(100)=JSON_VALUE(@input,'$.moduleIndexHash'), @total int=TRY_CONVERT(int,JSON_VALUE(@input,'$.indexedCount')), @since datetime2=DATEADD(hour,-24,SYSUTCDATETIME()); DECLARE @turns TABLE (id uniqueidentifier, seq bigint, result nvarchar(max), cap nvarchar(100)); DECLARE @inventory TABLE (name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, url nvarchar(900), section nvarchar(250), removed bit, summary nvarchar(1500)); INSERT @inventory SELECT name,url,section,removed,summary FROM OPENJSON(@input,'$.modules') WITH (name nvarchar(250) '$.module',url nvarchar(900) '$.documentationUrl',section nvarchar(250),removed bit,summary nvarchar(1500)); IF ISNULL(JSON_VALUE(@input,'$.status'),'')<>'LISTED' OR @hash IS NULL OR ISNULL(@total,0)=0 OR @total<>(SELECT COUNT(*) FROM @inventory) THROW 51000,'PYTHON_REPORT_SOURCE_INVENTORY_INCOMPLETE',1; DECLARE @entries TABLE(name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, proposal nvarchar(max)); INSERT @turns SELECT @job,a.content_artifact_pk,p.value,'propose-python-library-binding' FROM model.content_artifact a JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) b CROSS APPLY OPENJSON(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.entries') p WHERE a.artifact_kind=N'public-python-library-research-batch.v1' AND a.registered_date>=@since AND JSON_VALUE(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.contractId')='python-library-proposals-batch.v1'; INSERT @entries SELECT m.name,p.result FROM @inventory m CROSS APPLY ( SELECT TOP (1) result FROM @turns t WHERE t.cap='propose-python-library-binding' AND JSON_VALUE(result,'$.contractId')='python-library-binding-proposal.v1' AND JSON_VALUE(result,'$.status')='PROPOSED' AND JSON_VALUE(result,'$.source.module') COLLATE Latin1_General_100_BIN2=m.name AND JSON_VALUE(result,'$.source.documentationUrl')=m.url AND JSON_VALUE(result,'$.source.responseBodyHash') LIKE 'sha256:%' AND JSON_QUERY(result,'$.inputContract') IS NOT NULL AND JSON_QUERY(result,'$.outputContract') IS NOT NULL AND (SELECT COUNT(DISTINCT TRIM(value)) FROM OPENJSON(result,'$.useCases') WHERE type=1 AND NULLIF(TRIM(value),'') IS NOT NULL)=5 ORDER BY t.seq DESC) p WHERE m.removed=0; DECLARE @covered int=(SELECT COUNT(*) FROM @entries),@current int=(SELECT COUNT(*) FROM @inventory WHERE removed=0),@lf nchar(1)=NCHAR(10); DECLARE @sourceRecord nvarchar(max)=CASE WHEN JSON_VALUE(@input,'$.moduleIndexHash')=@hash THEN @input ELSE (SELECT TOP (1) result FROM @turns WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(result,'$.moduleIndexHash')=@hash ORDER BY seq DESC) END; DECLARE @title nvarchar(300)=JSON_VALUE(@sourceRecord,'$.sourceTitle'); DECLARE @vStart int=CHARINDEX('Python ',@title,2)+7,@vEnd int=CHARINDEX(' documentation',@title); DECLARE @version nvarchar(32)=SUBSTRING(@title,@vStart,CASE WHEN @vEnd>@vStart THEN @vEnd-@vStart ELSE 0 END); IF @version IS NULL OR @version NOT LIKE '[0-9]%.[0-9]%' OR @version LIKE '%[^0-9.]%' THROW 51000,'PYTHON_DOCUMENTATION_VERSION_UNRESOLVED',1; DECLARE @meta nvarchar(max)=(SELECT CASE WHEN @current=@covered THEN 'COMPLETE' ELSE 'PARTIAL' END AS status, CONVERT(varchar(36),@job) AS conversationId,COALESCE(@scope,'all') AS scope,@hash AS moduleIndexHash,@total AS indexedCount, JSON_QUERY((SELECT JSON_VALUE(@sourceRecord,'$.moduleIndexUrl') AS uri,@version AS version,@hash AS responseBodyHash FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) AS sourceIdentity, @current AS currentInScope,@covered AS proposals,@current-@covered AS missingCount,(SELECT COUNT(*) FROM @inventory WHERE removed=1) AS removedInScope, JSON_QUERY((SELECT TOP (10) m.name AS module,m.url AS documentationUrl FROM @inventory m LEFT JOIN @entries p ON m.name=p.name WHERE m.removed=0 AND p.name IS NULL ORDER BY m.name FOR JSON PATH)) AS nextMissingModules FOR JSON PATH,WITHOUT_ARRAY_WRAPPER); DECLARE @paragraph nchar(2)=@lf+@lf; DECLARE @sections nvarchar(max)=(SELECT STRING_AGG(CONVERT(nvarchar(max),CONCAT('## ',m.name,@lf,@lf,m.section,@lf,@lf,'[Python documentation](',m.url,')',@lf,@lf, CASE WHEN m.removed=1 THEN CONCAT('Removed. ',m.summary) WHEN p.proposal IS NULL THEN 'Awaiting a source-grounded binding proposal.' ELSE CONCAT(JSON_VALUE(p.proposal,'$.operation'),@lf,@lf,'**APIs**',@lf,fields.apis,@lf,@lf, '**Input contract**',@lf,'```json',@lf,JSON_QUERY(p.proposal,'$.inputContract'),@lf,'```',@lf,@lf, '**Output contract**',@lf,'```json',@lf,JSON_QUERY(p.proposal,'$.outputContract'),@lf,'```',@lf,@lf, '**Effects** ',JSON_VALUE(p.proposal,'$.effects'),@lf,@lf,'**Constraints** ',JSON_VALUE(p.proposal,'$.constraints'),@lf,@lf, '**Failure modes**',@lf,fields.failures,@lf,@lf,'**Ranked use cases**',@lf,fields.uses,@lf,@lf,'Source digest `',JSON_VALUE(p.proposal,'$.source.responseBodyHash'),'`') END)) COLLATE DATABASE_DEFAULT,@paragraph) WITHIN GROUP (ORDER BY m.name) FROM @inventory m LEFT JOIN @entries p ON m.name=p.name OUTER APPLY (SELECT (SELECT STRING_AGG(CONVERT(nvarchar(max),'- '+value),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.apis')) AS apis, (SELECT STRING_AGG(CONVERT(nvarchar(max),'- '+value),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.failureModes')) AS failures, (SELECT STRING_AGG(CONVERT(nvarchar(max),CONCAT(CONVERT(int,[key])+1,'. ',value)),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.useCases')) AS uses) fields); DECLARE @markdown nvarchar(max)=CONCAT('<!--',@meta,'-->',@lf,'# Python standard library provider proposals',@lf,@lf, 'Python ',@version,' documentation. ',@covered,' of ',@current,' current modules in scope have a source-grounded proposal. ',@lf,@lf, 'The bindings and rankings are estate design proposals. Removed modules are identified separately. ',@lf,@lf, '[Python library reference](https://docs.python.org/3/library/index.html) | [Module index](https://docs.python.org/3/py-modindex.html)',@lf,@lf,@sections,@lf); SELECT (SELECT 'content-artifact-change.v1' AS contractId, 'python-library-report:'+COALESCE(LOWER(CONVERT(varchar(36),@job)),@hash) AS artifactKind,@markdown AS [text], 'read-harness-authoring-state' AS verificationCapabilityId,JSON_QUERY(N'{\"resolvedDisposition\":\"terminated\"}') AS route, JSON_QUERY(N'{\"input\":{\"changeKind\":\"content-artifact-change\",\"includeDefinitions\":true},\"expected\":{\"disposition\":\"terminated\"}}') AS preflight FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from generate-python-library-report.verify-inventory $
operation generate-python-library-report.publish uses provider apply-declared-change
config: {"contractId":"declared-change.v1","changeKind":"content-artifact-change"}
input payload from generate-python-library-report.assemble $.value
operation generate-python-library-report.finish uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @row nvarchar(max)=COALESCE(JSON_VALUE(@input,'$.result[0][0].value'), JSON_QUERY(@input,'$.result[0][0]')); DECLARE @hash nvarchar(100)=JSON_VALUE(@row,'$.content_digest'); IF ISNULL(JSON_VALUE(@input,'$.disposition'),'')<>'COMMITTED' OR @hash IS NULL THROW 51000,'PYTHON_REPORT_NOT_RETAINED',1; DECLARE @body nvarchar(max)=(SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) FROM source.content_object WHERE content_digest=TRY_CONVERT(binary(32),SUBSTRING(@hash,8,64),2)); DECLARE @end int=CHARINDEX('-->',@body); DECLARE @meta nvarchar(max)=SUBSTRING(@body,5,CASE WHEN @end>4 THEN @end-5 ELSE 0 END); IF ISNULL(ISJSON(@meta),0)<>1 THROW 51000,'PYTHON_REPORT_READBACK_FAILED',1; SELECT JSON_MODIFY(JSON_MODIFY(JSON_MODIFY(@meta,'$.contractId','python-library-report.v1'),'$.contentDigest',@hash),'$.filename','python-library-provider-report.md') AS value;"}
input input from generate-python-library-report.publish $
outcome from generate-python-library-report.finish $.value
platform bind generate-python-library-report-research
platform: sda-node-consumer-runtime.v1
config: {"providerCapabilityId":"research-python-library-batch","providerId":"research-python-library-batch","authoritySource":"DATABASE","capabilityIdPath":"executionTarget","namespacePath":"executionNamespace","scenarioPath":"executionScenario","requestPath":"dispatchRequest","resultPath":"result","lineageMode":"retain-nested-execution"}
