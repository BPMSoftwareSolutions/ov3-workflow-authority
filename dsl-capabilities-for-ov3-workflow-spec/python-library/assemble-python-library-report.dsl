capability assemble-python-library-report
feature assemble-python-library-report sha256:199b66802352399cb03d7a4f1178eb52b88f9b7639786d083972d38b9ca48d84
intent: Publish a single Markdown report from the Python module inventory and proposed provider bindings retained in an OV3 conversation. Use this after researching libraries, including partial work. Supply additional named continuation conversations to complete missing modules. Report COMPLETE only when every current module in scope has its own sourced contracts and five ranked uses.
outcome: A retained Markdown report digest, module totals and outstanding count for this scope; an incomplete full inventory is refused before publication.
inquiry: Publish the Python standard library providers report from my research conversation.
inquiry: Assemble the Python library provider bindings and five use cases into one report.
input contract assemble-python-library-report-request.v1 {"type":"object","additionalProperties":false,"properties":{"conversationId":{"type":"string","format":"uuid"},"continuations":{"type":"array","maxItems":64,"items":{"type":"string","format":"uuid"}},"module":{"type":"string","minLength":1,"maxLength":250}},"required":["conversationId"]}
output contract python-library-report.v1 {"type":"object","additionalProperties":true,"required":["contractId","status"],"properties":{"contractId":{"const":"python-library-report.v1"},"status":{"enum":["COMPLETE","PARTIAL"]},"contentDigest":{"type":"string"},"scope":{"type":"string"},"proposals":{"type":"integer"},"missingCount":{"type":"integer"}}}
cli display outcome as json
scenario assemble-python-library-report root terminal
variants: COMPLETE:success,PARTIAL:failure
given: a named OV3 conversation with a Python module inventory and retained proposal turns
when: OV3 reconciles the inventory with the cited proposals and retains the Markdown by digest
then: OV3 returns the verified report digest and coverage for the requested scope
operation assemble-python-library-report.assemble uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @job uniqueidentifier=TRY_CONVERT(uniqueidentifier,JSON_VALUE(@input,'$.conversationId')); IF @job IS NULL THROW 51000,'PYTHON_REPORT_CONVERSATION_REQUIRED',1; DECLARE @scope nvarchar(250)=JSON_VALUE(@input,'$.module'); DECLARE @ids TABLE(id uniqueidentifier PRIMARY KEY); INSERT @ids VALUES(@job); INSERT @ids SELECT DISTINCT TRY_CONVERT(uniqueidentifier,value) FROM OPENJSON(@input,'$.continuations') WHERE TRY_CONVERT(uniqueidentifier,value) IS NOT NULL AND TRY_CONVERT(uniqueidentifier,value)<>@job; DECLARE @turns TABLE (id uniqueidentifier, seq bigint, result nvarchar(max), cap nvarchar(100)); INSERT @turns SELECT i.id, a.content_artifact_pk, JSON_QUERY(t.body,'$.result'), JSON_VALUE(t.body,'$.capability') FROM @ids i JOIN model.content_artifact a ON a.artifact_kind LIKE ('objective-pursuit:'+LOWER(CONVERT(varchar(36),i.id))+'#%') COLLATE Latin1_General_100_BIN2 JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) t WHERE ISJSON(t.body)=1 AND JSON_VALUE(t.body,'$.action')='CALL' AND JSON_VALUE(t.body,'$.capability') IN ('read-python-library-sources','propose-python-library-binding'); DECLARE @index nvarchar(max)=(SELECT TOP (1) result FROM @turns WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(result,'$.status')='LISTED' ORDER BY seq DESC); DECLARE @hash nvarchar(100)=JSON_VALUE(@index,'$.moduleIndexHash'), @total int=TRY_CONVERT(int,JSON_VALUE(@index,'$.indexedCount')); DECLARE @inventory TABLE (name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, url nvarchar(900), section nvarchar(250), removed bit, summary nvarchar(1500)); INSERT @inventory SELECT m.name,MAX(m.url),MAX(m.section),CONVERT(bit,MAX(CONVERT(int,m.removed))),MAX(m.summary) FROM @turns t CROSS APPLY OPENJSON(t.result,'$.modules') WITH (name nvarchar(250) '$.module',url nvarchar(900) '$.documentationUrl',section nvarchar(250),removed bit,summary nvarchar(1500)) m WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(t.result,'$.moduleIndexHash')=@hash AND JSON_VALUE(t.result,'$.status')='LISTED' AND (@scope IS NULL OR m.name COLLATE Latin1_General_100_BIN2=@scope) GROUP BY m.name; IF @hash IS NULL OR NOT EXISTS (SELECT 1 FROM @inventory) OR (@scope IS NULL AND @total<>(SELECT COUNT(*) FROM @inventory)) THROW 51000,'PYTHON_REPORT_SOURCE_INVENTORY_INCOMPLETE',1; DECLARE @entries TABLE(name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, proposal nvarchar(max)); DECLARE @since datetime2=(SELECT MIN(a.registered_date) FROM model.content_artifact a JOIN @turns t ON t.seq=a.content_artifact_pk WHERE t.id=@job AND t.cap='read-python-library-sources' AND JSON_VALUE(t.result,'$.moduleIndexHash')=@hash); INSERT @turns SELECT @job,a.content_artifact_pk,p.value,'propose-python-library-binding' FROM model.content_artifact a JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) b CROSS APPLY OPENJSON(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.entries') p WHERE a.artifact_kind=N'public-python-library-research-batch.v1' AND a.registered_date>=@since AND JSON_VALUE(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.contractId')='python-library-proposals-batch.v1'; INSERT @entries SELECT m.name,p.result FROM @inventory m CROSS APPLY ( SELECT TOP (1) result FROM @turns t WHERE t.cap='propose-python-library-binding' AND JSON_VALUE(result,'$.contractId')='python-library-binding-proposal.v1' AND JSON_VALUE(result,'$.status')='PROPOSED' AND JSON_VALUE(result,'$.source.module') COLLATE Latin1_General_100_BIN2=m.name AND JSON_VALUE(result,'$.source.documentationUrl')=m.url AND JSON_VALUE(result,'$.source.responseBodyHash') LIKE 'sha256:%' AND JSON_QUERY(result,'$.inputContract') IS NOT NULL AND JSON_QUERY(result,'$.outputContract') IS NOT NULL AND (SELECT COUNT(DISTINCT TRIM(value)) FROM OPENJSON(result,'$.useCases') WHERE type=1 AND NULLIF(TRIM(value),'') IS NOT NULL)=5 ORDER BY t.seq DESC) p WHERE m.removed=0; DECLARE @covered int=(SELECT COUNT(*) FROM @entries),@current int=(SELECT COUNT(*) FROM @inventory WHERE removed=0),@lf nchar(1)=NCHAR(10); DECLARE @sourceRecord nvarchar(max)=CASE WHEN JSON_VALUE(@input,'$.moduleIndexHash')=@hash THEN @input ELSE (SELECT TOP (1) result FROM @turns WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(result,'$.moduleIndexHash')=@hash ORDER BY seq DESC) END; DECLARE @title nvarchar(300)=JSON_VALUE(@sourceRecord,'$.sourceTitle'); DECLARE @vStart int=CHARINDEX('Python ',@title,2)+7,@vEnd int=CHARINDEX(' documentation',@title); DECLARE @version nvarchar(32)=SUBSTRING(@title,@vStart,CASE WHEN @vEnd>@vStart THEN @vEnd-@vStart ELSE 0 END); IF @version IS NULL OR @version NOT LIKE '[0-9]%.[0-9]%' OR @version LIKE '%[^0-9.]%' THROW 51000,'PYTHON_DOCUMENTATION_VERSION_UNRESOLVED',1; DECLARE @meta nvarchar(max)=(SELECT CASE WHEN @current=@covered THEN 'COMPLETE' ELSE 'PARTIAL' END AS status, CONVERT(varchar(36),@job) AS conversationId,COALESCE(@scope,'all') AS scope,@hash AS moduleIndexHash,@total AS indexedCount, JSON_QUERY((SELECT JSON_VALUE(@sourceRecord,'$.moduleIndexUrl') AS uri,@version AS version,@hash AS responseBodyHash FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) AS sourceIdentity, @current AS currentInScope,@covered AS proposals,@current-@covered AS missingCount,(SELECT COUNT(*) FROM @inventory WHERE removed=1) AS removedInScope, JSON_QUERY((SELECT TOP (10) m.name AS module,m.url AS documentationUrl FROM @inventory m LEFT JOIN @entries p ON m.name=p.name WHERE m.removed=0 AND p.name IS NULL ORDER BY m.name FOR JSON PATH)) AS nextMissingModules FOR JSON PATH,WITHOUT_ARRAY_WRAPPER); DECLARE @paragraph nchar(2)=@lf+@lf; DECLARE @sections nvarchar(max)=(SELECT STRING_AGG(CONVERT(nvarchar(max),CONCAT('## ',m.name,@lf,@lf,m.section,@lf,@lf,'[Python documentation](',m.url,')',@lf,@lf, CASE WHEN m.removed=1 THEN CONCAT('Removed. ',m.summary) WHEN p.proposal IS NULL THEN 'Awaiting a source-grounded binding proposal.' ELSE CONCAT(JSON_VALUE(p.proposal,'$.operation'),@lf,@lf,'**APIs**',@lf,fields.apis,@lf,@lf, '**Input contract**',@lf,'```json',@lf,JSON_QUERY(p.proposal,'$.inputContract'),@lf,'```',@lf,@lf, '**Output contract**',@lf,'```json',@lf,JSON_QUERY(p.proposal,'$.outputContract'),@lf,'```',@lf,@lf, '**Effects** ',JSON_VALUE(p.proposal,'$.effects'),@lf,@lf,'**Constraints** ',JSON_VALUE(p.proposal,'$.constraints'),@lf,@lf, '**Failure modes**',@lf,fields.failures,@lf,@lf,'**Ranked use cases**',@lf,fields.uses,@lf,@lf,'Source digest `',JSON_VALUE(p.proposal,'$.source.responseBodyHash'),'`') END)) COLLATE DATABASE_DEFAULT,@paragraph) WITHIN GROUP (ORDER BY m.name) FROM @inventory m LEFT JOIN @entries p ON m.name=p.name OUTER APPLY (SELECT (SELECT STRING_AGG(CONVERT(nvarchar(max),'- '+value),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.apis')) AS apis, (SELECT STRING_AGG(CONVERT(nvarchar(max),'- '+value),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.failureModes')) AS failures, (SELECT STRING_AGG(CONVERT(nvarchar(max),CONCAT(CONVERT(int,[key])+1,'. ',value)),@lf) WITHIN GROUP (ORDER BY CONVERT(int,[key])) FROM OPENJSON(p.proposal,'$.useCases')) AS uses) fields); DECLARE @markdown nvarchar(max)=CONCAT('<!--',@meta,'-->',@lf,'# Python standard library provider proposals',@lf,@lf, 'Python ',@version,' documentation. ',@covered,' of ',@current,' current modules in scope have a source-grounded proposal. ',@lf,@lf, 'The bindings and rankings are estate design proposals. Removed modules are identified separately. ',@lf,@lf, '[Python library reference](https://docs.python.org/3/library/index.html) | [Module index](https://docs.python.org/3/py-modindex.html)',@lf,@lf,@sections,@lf); SELECT (SELECT 'content-artifact-change.v1' AS contractId, 'python-library-report:'+COALESCE(LOWER(CONVERT(varchar(36),@job)),@hash) AS artifactKind,@markdown AS [text], 'read-harness-authoring-state' AS verificationCapabilityId,JSON_QUERY(N'{\"resolvedDisposition\":\"terminated\"}') AS route, JSON_QUERY(N'{\"input\":{\"changeKind\":\"content-artifact-change\",\"includeDefinitions\":true},\"expected\":{\"disposition\":\"terminated\"}}') AS preflight FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from assemble-python-library-report $
operation assemble-python-library-report.publish uses provider apply-declared-change
config: {"contractId":"declared-change.v1","changeKind":"content-artifact-change"}
input payload from assemble-python-library-report.assemble $.value
operation assemble-python-library-report.finish uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @row nvarchar(max)=COALESCE(JSON_VALUE(@input,'$.result[0][0].value'), JSON_QUERY(@input,'$.result[0][0]')); DECLARE @hash nvarchar(100)=JSON_VALUE(@row,'$.content_digest'); IF ISNULL(JSON_VALUE(@input,'$.disposition'),'')<>'COMMITTED' OR @hash IS NULL THROW 51000,'PYTHON_REPORT_NOT_RETAINED',1; DECLARE @body nvarchar(max)=(SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) FROM source.content_object WHERE content_digest=TRY_CONVERT(binary(32),SUBSTRING(@hash,8,64),2)); DECLARE @end int=CHARINDEX('-->',@body); DECLARE @meta nvarchar(max)=SUBSTRING(@body,5,CASE WHEN @end>4 THEN @end-5 ELSE 0 END); IF ISNULL(ISJSON(@meta),0)<>1 THROW 51000,'PYTHON_REPORT_READBACK_FAILED',1; SELECT JSON_MODIFY(JSON_MODIFY(JSON_MODIFY(@meta,'$.contractId','python-library-report.v1'),'$.contentDigest',@hash),'$.filename','python-library-provider-report.md') AS value;"}
input input from assemble-python-library-report.publish $
outcome from assemble-python-library-report.finish $.value
