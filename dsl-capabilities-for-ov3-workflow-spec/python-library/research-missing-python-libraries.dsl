capability research-missing-python-libraries
feature research-missing-python-libraries sha256:272b4d3d4d96981c487e610693033d3c436fc02eeef766c00c16838fcb32ffd6
intent: Finish the full Python library binding research without asking to narrow it. Use the conversationId of a retained Python inventory. Reconcile completed work, run pending modules in retained batches and resume after interruption. Then call assemble-python-library-report with the same inventory conversationId to publish and check coverage.
outcome: SETTLED or PARTIAL with batch counts. The report assembler determines module coverage.
inquiry: Research every remaining Python standard library module and retain the work.
inquiry: Continue the full Python provider report without repeating completed modules.
input contract research-missing-python-libraries-request.v1 {"type":"object","additionalProperties":false,"properties":{"conversationId":{"type":"string","format":"uuid"},"continuations":{"type":"array","maxItems":64,"items":{"type":"string","format":"uuid"}},"module":{"type":"string","minLength":1,"maxLength":250},"maxModules":{"type":"integer","minimum":1,"maximum":400}},"required":["conversationId"]}
output contract python-library-research-pass.v1 {"type":"object","additionalProperties":true,"required":["contractId","status"],"properties":{"contractId":{"const":"python-library-research-pass.v1"},"status":{"enum":["SETTLED","PARTIAL"]},"batchesReturned":{"type":"integer"},"batchesRetained":{"type":"integer"}}}
cli display outcome as json
scenario research-missing-python-libraries root terminal
variants: SETTLED:success,PARTIAL:failure
given: a named OV3 inventory conversation and its retained research coverage
when: OV3 partitions the uncovered current modules into bounded batches and invokes each batch exactly once in this pass
then: OV3 returns the batch receipt counts and names the coverage check
operation research-missing-python-libraries.plan uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @job uniqueidentifier=TRY_CONVERT(uniqueidentifier,JSON_VALUE(@input,'$.conversationId')); IF @job IS NULL THROW 51000,'PYTHON_REPORT_CONVERSATION_REQUIRED',1; DECLARE @scope nvarchar(250)=JSON_VALUE(@input,'$.module'); DECLARE @ids TABLE(id uniqueidentifier PRIMARY KEY); INSERT @ids VALUES(@job); INSERT @ids SELECT DISTINCT TRY_CONVERT(uniqueidentifier,value) FROM OPENJSON(@input,'$.continuations') WHERE TRY_CONVERT(uniqueidentifier,value) IS NOT NULL AND TRY_CONVERT(uniqueidentifier,value)<>@job; DECLARE @turns TABLE (id uniqueidentifier, seq bigint, result nvarchar(max), cap nvarchar(100)); INSERT @turns SELECT i.id, a.content_artifact_pk, JSON_QUERY(t.body,'$.result'), JSON_VALUE(t.body,'$.capability') FROM @ids i JOIN model.content_artifact a ON a.artifact_kind LIKE ('objective-pursuit:'+LOWER(CONVERT(varchar(36),i.id))+'#%') COLLATE Latin1_General_100_BIN2 JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) t WHERE ISJSON(t.body)=1 AND JSON_VALUE(t.body,'$.action')='CALL' AND JSON_VALUE(t.body,'$.capability') IN ('read-python-library-sources','propose-python-library-binding'); DECLARE @index nvarchar(max)=(SELECT TOP (1) result FROM @turns WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(result,'$.status')='LISTED' ORDER BY seq DESC); DECLARE @hash nvarchar(100)=JSON_VALUE(@index,'$.moduleIndexHash'), @total int=TRY_CONVERT(int,JSON_VALUE(@index,'$.indexedCount')); DECLARE @inventory TABLE (name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, url nvarchar(900), section nvarchar(250), removed bit, summary nvarchar(1500)); INSERT @inventory SELECT m.name,MAX(m.url),MAX(m.section),CONVERT(bit,MAX(CONVERT(int,m.removed))),MAX(m.summary) FROM @turns t CROSS APPLY OPENJSON(t.result,'$.modules') WITH (name nvarchar(250) '$.module',url nvarchar(900) '$.documentationUrl',section nvarchar(250),removed bit,summary nvarchar(1500)) m WHERE id=@job AND cap='read-python-library-sources' AND JSON_VALUE(t.result,'$.moduleIndexHash')=@hash AND JSON_VALUE(t.result,'$.status')='LISTED' AND (@scope IS NULL OR m.name COLLATE Latin1_General_100_BIN2=@scope) GROUP BY m.name; IF @hash IS NULL OR NOT EXISTS (SELECT 1 FROM @inventory) OR (@scope IS NULL AND @total<>(SELECT COUNT(*) FROM @inventory)) THROW 51000,'PYTHON_REPORT_SOURCE_INVENTORY_INCOMPLETE',1; DECLARE @entries TABLE(name nvarchar(250) COLLATE Latin1_General_100_BIN2 PRIMARY KEY, proposal nvarchar(max)); DECLARE @since datetime2=(SELECT MIN(a.registered_date) FROM model.content_artifact a JOIN @turns t ON t.seq=a.content_artifact_pk WHERE t.id=@job AND t.cap='read-python-library-sources' AND JSON_VALUE(t.result,'$.moduleIndexHash')=@hash); INSERT @turns SELECT @job,a.content_artifact_pk,p.value,'propose-python-library-binding' FROM model.content_artifact a JOIN source.content_object co ON co.content_digest=a.content_digest CROSS APPLY (SELECT CONVERT(nvarchar(max),CONVERT(varchar(max),co.content_bytes) COLLATE Latin1_General_100_BIN2_UTF8) AS body) b CROSS APPLY OPENJSON(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.entries') p WHERE a.artifact_kind=N'public-python-library-research-batch.v1' AND a.registered_date>=@since AND JSON_VALUE(CASE WHEN ISJSON(b.body)=1 THEN b.body END,'$.contractId')='python-library-proposals-batch.v1'; INSERT @entries SELECT m.name,p.result FROM @inventory m CROSS APPLY ( SELECT TOP (1) result FROM @turns t WHERE t.cap='propose-python-library-binding' AND JSON_VALUE(result,'$.contractId')='python-library-binding-proposal.v1' AND JSON_VALUE(result,'$.status')='PROPOSED' AND JSON_VALUE(result,'$.source.module') COLLATE Latin1_General_100_BIN2=m.name AND JSON_VALUE(result,'$.source.documentationUrl')=m.url AND JSON_VALUE(result,'$.source.responseBodyHash') LIKE 'sha256:%' AND JSON_QUERY(result,'$.inputContract') IS NOT NULL AND JSON_QUERY(result,'$.outputContract') IS NOT NULL AND (SELECT COUNT(DISTINCT TRIM(value)) FROM OPENJSON(result,'$.useCases') WHERE type=1 AND NULLIF(TRIM(value),'') IS NOT NULL)=5 ORDER BY t.seq DESC) p WHERE m.removed=0; DECLARE @limit int=COALESCE(TRY_CONVERT(int,TRY_CONVERT(float,JSON_VALUE(@input,'$.maxModules'))),400); IF @limit NOT BETWEEN 1 AND 400 THROW 51000,'PYTHON_REPORT_BATCH_BOUND_INVALID',1; DECLARE @work TABLE(ord int, url nvarchar(900)); INSERT @work SELECT TOP (@limit) ROW_NUMBER() OVER (ORDER BY m.name),m.url FROM @inventory m LEFT JOIN @entries e ON m.name=e.name WHERE m.removed=0 AND e.name IS NULL ORDER BY m.name; DECLARE @batches nvarchar(max)=(SELECT 'research-python-library-batch' AS executionTarget,'sidefx:capabilities' AS executionNamespace, 'research-python-library-batch' AS executionScenario,'json' AS inputType, JSON_QUERY((SELECT JSON_QUERY((SELECT w.url FROM @work w WHERE (w.ord-1)/5=g.grp ORDER BY w.ord FOR JSON PATH)) AS sources FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) AS dispatchRequest FROM (SELECT DISTINCT (ord-1)/5 AS grp FROM @work) g ORDER BY g.grp FOR JSON PATH); SELECT (SELECT JSON_QUERY(COALESCE(@batches,'[]')) AS batches FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from research-missing-python-libraries $
operation research-missing-python-libraries.research kind for-each port research-missing-python-libraries-research over result.value.batches max 80
operation research-missing-python-libraries.finish uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @planned int=(SELECT COUNT(*) FROM OPENJSON(@input)); DECLARE @retained int=(SELECT COUNT(*) FROM OPENJSON(@input) WHERE JSON_VALUE(value,'$.result.status')='RETAINED' AND JSON_VALUE(value,'$.result.contentDigest') LIKE 'sha256:%'); SELECT (SELECT 'python-library-research-pass.v1' AS contractId,CASE WHEN @planned=@retained THEN 'SETTLED' ELSE 'PARTIAL' END AS status, @planned AS batchesReturned,@retained AS batchesRetained,'assemble-python-library-report' AS coverageCheck, 'Call assemble-python-library-report with the same conversationId to read coverage and publish the report.' AS nextAction FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from research-missing-python-libraries.research $
outcome from research-missing-python-libraries.finish $.value
platform bind research-missing-python-libraries-research
platform: sda-node-consumer-runtime.v1
config: {"providerCapabilityId":"research-python-library-batch","providerId":"research-python-library-batch","authoritySource":"DATABASE","capabilityIdPath":"executionTarget","namespacePath":"executionNamespace","scenarioPath":"executionScenario","requestPath":"dispatchRequest","resultPath":"result","lineageMode":"retain-nested-execution"}
