capability publish-python-reuse-result
feature publish-python-reuse-result sha256:8197669ce642b75545bb997f4705f2f9a17eb979b0d767b77086d81e6a85da28
intent: Publish the notice or ledger from a Python reuse benchmark as a portable JSON manifest. Supply the exact text, UTF-8 byte count, padded Base64, CRC-32 and SHA-256 from the declared Python operations. Include claimedSha256 and matches for a ledger.
outcome: COMPLETE with the read-back artifact digest. The objective verifier independently checks the artifact and the actual Python call receipts.
inquiry: Publish the escaped notice or exact CRLF ledger integrity manifest from its Python tool results.
input contract publish-python-reuse-result-request.v1 {"type":"object","additionalProperties":false,"required":["specimen","text","byteCount","base64","crc32","sha256"],"properties":{"specimen":{"enum":["notice","ledger"]},"text":{"type":"string","maxLength":512},"byteCount":{"type":"integer","minimum":0,"maximum":2048},"base64":{"type":"string","maxLength":3072},"crc32":{"type":"string","pattern":"^[0-9a-f]{8}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"claimedSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"matches":{"type":"boolean"}}}
output contract python-reuse-publication.v1 {"type":"object","additionalProperties":false,"required":["contractId","status","specimen","sourceCorpusDigest","contentDigest"],"properties":{"contractId":{"const":"python-reuse-publication.v1"},"status":{"const":"COMPLETE"},"specimen":{"enum":["notice","ledger"]},"sourceCorpusDigest":{"const":"sha256:1c5eca88ec12db41c0a904a1cf7f8a1e6626ef909f62c6492afe43b12bd551ff"},"contentDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
cli display outcome as json
scenario publish-python-reuse-result root terminal
variants: COMPLETE:success
given: a specimen identity and the manifest values obtained by executing the Python operations
when: OV3 publishes the JSON manifest through the declared content artifact writer
then: it returns the digest of the retained bytes for independent verification against the objective
operation publish-python-reuse-result.prepare uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @name nvarchar(20)=JSON_VALUE(@input,'$.specimen'); IF @name='ledger' AND ((SELECT COUNT(*) FROM OPENJSON(@input) WHERE [key]='matches' AND type=3)<>1 OR JSON_VALUE(@input,'$.claimedSha256') IS NULL) THROW 51000,'LEDGER_COMPARISON_REQUIRED',1; IF @name='notice' AND EXISTS(SELECT 1 FROM OPENJSON(@input) WHERE [key] IN ('matches','claimedSha256')) THROW 51000,'NOTICE_FIELDS_INVALID',1; SELECT (SELECT 'content-artifact-change.v1' AS contractId,'python-reuse-manifest' AS artifactKind,@input AS [text], 'read-harness-authoring-state' AS verificationCapabilityId,JSON_QUERY(N'{\"resolvedDisposition\":\"terminated\"}') AS route, JSON_QUERY(N'{\"input\":{\"changeKind\":\"content-artifact-change\",\"includeDefinitions\":true},\"expected\":{\"disposition\":\"terminated\"}}') AS preflight FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value;"}
input input from publish-python-reuse-result $
operation publish-python-reuse-result.publish uses provider apply-declared-change
config: {"contractId":"declared-change.v1","changeKind":"content-artifact-change"}
input payload from publish-python-reuse-result.prepare $.value
operation publish-python-reuse-result.finish uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @corpus varchar(71)='sha256:1c5eca88ec12db41c0a904a1cf7f8a1e6626ef909f62c6492afe43b12bd551ff'; DECLARE @returned nvarchar(max)=COALESCE(JSON_VALUE(@input,'$.result[0][0].value'),JSON_QUERY(@input,'$.result[0][0]')); DECLARE @digest varchar(71)=JSON_VALUE(@returned,'$.content_digest'); IF ISNULL(JSON_VALUE(@input,'$.disposition'),'')<>'COMMITTED' OR @digest IS NULL THROW 51000,'MANIFEST_PUBLICATION_FAILED',1; DECLARE @stored TABLE(body varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @stored SELECT TOP(1) c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON a.content_digest=c.content_digest WHERE a.artifact_kind=N'python-reuse-manifest' AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@digest,8,64),2) AND c.content_digest=HASHBYTES('SHA2_256',c.content_bytes); DECLARE @body nvarchar(max)=(SELECT CONVERT(nvarchar(max),body) FROM @stored); IF @body IS NULL OR ISJSON(@body)<>1 THROW 51000,'MANIFEST_READBACK_FAILED',1; SELECT (SELECT 'python-reuse-publication.v1' AS contractId,'COMPLETE' AS status,JSON_VALUE(@body,'$.specimen') AS specimen, @corpus AS sourceCorpusDigest,@digest AS contentDigest FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) AS value; "}
input input from publish-python-reuse-result.publish $
outcome from publish-python-reuse-result.finish $.value
