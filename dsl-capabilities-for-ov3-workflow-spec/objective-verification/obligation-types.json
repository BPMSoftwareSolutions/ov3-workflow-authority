{
  "fixture_digest": {
    "op": "same_digest",
    "quantifier": "objective",
    "value": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "execution_count": {
    "op": "exactly",
    "quantifier": "objective",
    "value": {"type":"integer","minimum":0}
  },
  "source_snapshot": {
    "op": "same_snapshot",
    "quantifier": "objective",
    "value": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "provider_use": {
    "op": "used",
    "quantifier": "objective",
    "value": {
      "type": "string",
      "minLength": 1
    }
  },
  "population": {
    "op": "set_equals",
    "quantifier": "all_index_entries",
    "value": {
      "type": "object",
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "current",
        "removed"
      ],
      "additionalProperties": false
    }
  },
  "contract_pair": {
    "op": "has_both",
    "quantifier": "each_current_module",
    "value": {
      "type": "object",
      "properties": {
        "input": {
          "const": "json-object"
        },
        "output": {
          "const": "json-object"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    }
  },
  "ranked_count": {
    "op": "exactly",
    "quantifier": "each_current_module",
    "value": {
      "type": "integer",
      "minimum": 0
    }
  },
  "publication": {
    "op": "delivered",
    "quantifier": "objective",
    "value": {
      "enum": [
        "markdown-report",
        "json-manifest",
        "standalone-html-page"
      ]
    }
  }
}
