capability verify-objective-fulfillment
feature verify-objective-fulfillment sha256:7d21b2780b785cd5447792dce1978934e09e48f4db33897e7ae253ea5a6260e8
intent: Independently verify whether a published artifact fulfills the original objective. Resolve its declared evidence profile, pin the source version and exact bytes, inspect the artifact against retained proof receipts, and use TypeSafe System One for typed scope inference.
outcome: objective-verification.v1 FULFILLED or UNVERIFIED, bound to the objective, conversation, publication turn, artifact, source snapshot and receipts.
inquiry: Does this published artifact satisfy the entire original objective?
input contract verify-objective-fulfillment-request.v1 {"type":"object","additionalProperties":false,"required":["conversationId","publicationTurn"],"properties":{"conversationId":{"type":"string","format":"uuid"},"publicationTurn":{"type":"integer","minimum":1},"objective":{"type":"string","minLength":1,"maxLength":16000},"expectedSourceVersion":{"type":"string","minLength":1,"maxLength":32},"expectedArtifactDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"expectedSourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
output contract objective-verification.v1 {"type":"object","additionalProperties":true,"required":["contractId","status","reason"],"properties":{"contractId":{"const":"objective-verification.v1"},"status":{"enum":["FULFILLED","UNVERIFIED"]},"reason":{"type":"string"}}}
contract objective-obligations.v1 {"type":"object","additionalProperties":false,"required":["contractId","request","obligations"],"properties":{"contractId":{"const":"objective-obligations.v1"},"request":{"type":"string","minLength":1,"maxLength":16000},"obligations":{"type":"array","minItems":1,"items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["id","kind","operator","quantifier","expected","observed","proof"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"kind":{"const":"fixture_digest"},"operator":{"const":"same_digest"},"quantifier":{"const":"objective"},"expected":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"observed":{"anyOf":[{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},{"type":"null"}]},"proof":{"enum":["PROVED","UNPROVED"]}}},{"type":"object","additionalProperties":false,"required":["id","kind","operator","quantifier","expected","observed","proof"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"kind":{"const":"execution_count"},"operator":{"const":"exactly"},"quantifier":{"const":"objective"},"expected":{"type":"integer","minimum":0},"observed":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]},"proof":{"enum":["PROVED","UNPROVED"]}}},{"type":"object","additionalProperties":false,"required":["id","kind","operator","quantifier","expected","observed","proof"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"kind":{"const":"source_snapshot"},"operator":{"const":"same_snapshot"},"quantifier":{"const":"objective"},"expected":{"type":"object","properties":{"uri":{"type":"string","format":"uri"},"version":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+){1,2}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"required":["uri","version","digest"],"additionalProperties":false},"observed":{"anyOf":[{"type":"object","properties":{"uri":{"type":"string","format":"uri"},"version":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+){1,2}$"},"digest":{"ty