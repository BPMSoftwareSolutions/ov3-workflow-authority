 "sections": [
  {
   "sectionId": "hero",
   "regionId": "main",
   "order": 1,
   "component": {
    "kind": "hero",
    "version": 1
   },
   "props": {
    "eyebrow": "Team selection",
    "headline": "Build your team of up to six",
    "lede": "Load your animals and your current team, tick up to six and save. The save names the team revision you saw, so a stale or oversized team is refused and the saved team is kept.",
    "primaryActionId": "open-circuit"
   },
   "bindings": {
    "figure": {
     "kind": "read",
     "reader": "scenario",
     "input": {
      "capabilityId": "nerdery-set-animal-team",
      "namespaceId": "sidefx:capabilities",
      "page": "scenario-1"
     },
     "pointer": "/slides/0"
    }
   },
   "actions": [
    {
     "actionId": "open-circuit",
     "kind": "navigate",
     "to": "/circuit/explorer?capability=nerdery-set-animal-team&namespace=sidefx%3Acapabilities"
    }
   ]
  },
  {
   "sectionId": "load",
   "regionId": "main",
   "order": 2,
   "component": {
    "kind": "section",
    "version": 1
   },
   "props": {
    "heading": "Start here",
    "actions": [
     {
      "actionId": "mine",
      "label": "1. Load my animals"
     },
     {
      "actionId": "home",
      "label": "2. Load my current team"
     }
    ]
   },
   "actions": [
    {
     "actionId": "mine",
     "kind": "observe",
     "subject": "nerdery-view-collected-animals",
     "namespace": "sidefx:capabilities",
     "result": "mine",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {}
      }
     }
    },
    {
     "actionId": "home",
     "kind": "observe",
     "subject": "nerdery-view-wildlife-home",
     "namespace": "sidefx:capabilities",
     "result": "home",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {}
      }
     }
    }
   ]
  },
  {
   "sectionId": "current",
   "regionId": "main",
   "order": 3,
   "component": {
    "kind": "field-list",
    "version": 1
   },
   "props": {
    "label": "Current team"
   },
   "when": {
    "result": "home",
    "pointer": "/status",
    "equals": "VISIBLE"
   },
   "bindings": {
    "fields": {
     "kind": "read",
     "reader": "run",
     "result": "home",
     "pointer": "/team",
     "map": {
      "Revision": "/revision",
      "Size": "/size",
      "Members": {
       "pointer": "/members",
       "field": "displayName",
       "join": ", "
      }
     }
    }
   }
  },
  {
   "sectionId": "pick",
   "regionId": "main",
   "order": 4,
   "component": {
    "kind": "form",
    "version": 1
   },
   "when": {
    "result": "mine",
    "pointer": "/status",
    "equals": "LISTED"
   },
   "props": {
    "submit": "3. Save this team"
   },
   "bindings": {
    "fields": {
     "kind": "read",
     "reader": "run",
     "result": "mine",
     "pointer": "/items",
     "map": {
      "name": "encounterIds",
      "kind": "checkbox",
      "id": "/encounterId",
      "label": "/displayName",
      "value": "/encounterId",
      "checked": {
       "literal": false
      }
     }
    }
   },
   "actions": [
    {
     "actionId": "save",
     "kind": "observe",
     "subject": "nerdery-set-animal-team",
     "namespace": "sidefx:capabilities",
     "result": "team",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {
        "expectedRevision": {
         "source": "run",
         "result": "home",
         "pointer": "/team/revision"
        },
        "encounterIds": {
         "form": "encounterIds",
         "as": "list"
        }
       }
      }
     }
    }
   ],
   "events": [
    {
     "on": "submit",
     "actionId": "save"
    }
   ]
  },
  {
   "sectionId": "saved",
   "regionId": "main",
   "order": 5,
   "component": {
    "kind": "field-list",
    "version": 1
   },
   "props": {
    "label": "Saved"
   },
   "when": {
    "result": "team",
    "pointer": "/status",
    "equals": "SAVED"
   },
   "bindings": {
    "fields": {
     "kind": "read",
     "reader": "run",
     "result": "team",
     "pointer": "/team",
     "map": {
      "Revision": "/revision",
      "Size": "/size",
      "Members": {
       "pointer": "/encounterIds",
       "join": ", "
      }
     }
    }
   }
  },
  {
   "sectionId": "team-refused",
   "regionId": "main",
   "order": 6,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "error",
    "title": "Refused by the capability"
   },
   "bindings": {
    "body": {
     "kind": "read",
     "reader": "run",
     "result": "team",
     "pointer": "/reason/code"
    }
   },
   "when": {
    "result": "team",
    "pointer": "/status",
    "equals": "REFUSED"
   }
  },
  {
   "sectionId": "seven-heading",
   "regionId": "main",
   "order": 7,
   "component": {
    "kind": "heading",
    "version": 1
   },
   "props": {
    "text": "Try a team of seven",
    "level": 2
   }
  },
  {
   "sectionId": "seven",
   "regionId": "main",
   "order": 8,
   "component": {
    "kind": "section",
    "version": 1
   },
   "props": {
    "body": [
     "A team holds at most six animals. After loading your current team, this sends seven and shows the capability's refusal; the saved team does not change."
    ],
    "actions": [
     {
      "actionId": "seven",
      "label": "Send a team of seven"
     }
    ]
   },
   "actions": [
    {
     "actionId": "seven",
     "kind": "observe",
     "subject": "nerdery-set-animal-team",
     "namespace": "sidefx:capabilities",
     "result": "seven",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {
        "expectedRevision": {
         "source": "run",
         "result": "home",
         "pointer": "/team/revision"
        },
        "encounterIds": [
         "enc-interview-1",
         "enc-interview-2",
         "e3",
         "e4",
         "e5",
         "e6",
         "e7"
        ]
       }
      }
     }
    }
   ]
  },
  {
   "sectionId": "seven-refused",
   "regionId": "main",
   "order": 9,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "error",
    "title": "Refused by the capability"
   },
   "bindings": {
    "body": {
     "kind": "read",
     "reader": "run",
     "result": "seven",
     "pointer": "/reason/code"
    }
   },
   "when": {
    "result": "seven",
    "pointer": "/status",
    "equals": "REFUSED"
   }
  }
 ]
