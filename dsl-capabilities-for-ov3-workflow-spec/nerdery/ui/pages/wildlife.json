    "title": "The journey",
    "cards": [
     {
      "cardId": "before",
      "title": "1. Before you collect",
      "body": "Browse and search the catalog. An animal you have not collected shows only its common name, number, range and picture.",
      "promise": "Locked fields never leave the server.",
      "meta": "Collection",
      "link": "/circuit/wildlife-collection",
      "linkLabel": "Open"
     },
     {
      "cardId": "capture",
      "title": "2. Capture an encounter",
      "body": "Upload a photo and record where you saw the animal, with an optional nickname.",
      "promise": "Photo verification is deferred and recorded as not performed.",
      "meta": "Capture",
      "link": "/circuit/wildlife-capture",
      "linkLabel": "Open"
     },
     {
      "cardId": "after",
      "title": "3. After you collect",
      "body": "The animal's scientific name, types, stats and attributes unlock, for you alone. A second encounter is a second individual.",
      "promise": "Unlocks are per user.",
      "meta": "Animal",
      "link": "/circuit/wildlife-animal",
      "linkLabel": "Open"
     },
     {
      "cardId": "team",
      "title": "4. Build your team",
      "body": "Choose up to six of your individuals and see them on your home page.",
      "promise": "A seventh member is refused and the saved team stays as it was.",
      "meta": "Team",
      "link": "/circuit/wildlife-team",
      "linkLabel": "Open"
     },
     {
      "cardId": "refusals",
      "title": "5. What the system refuses",
      "body": "A citizen adding to the catalog, and a session presented under someone else's identity.",
      "promise": "Each refusal is named by the capability.",
      "meta": "Refusals",
      "link": "/circuit/wildlife-refusals",
      "linkLabel": "Open"
     }
    ]
   }
