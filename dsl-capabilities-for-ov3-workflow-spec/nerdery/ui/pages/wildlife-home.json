      "actionId": "home",
      "label": "Show my home"
     }
    ]
   },
   "actions": [
    {
     "actionId": "home",
     "kind": "observe",
     "subject": "nerdery-view-wildlife-home",
     "namespace": "sidefx:capabilities",
     "result": "home",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {}
      }
     }
    }
   ]
  },
  {
   "sectionId": "size",
   "regionId": "main",
   "order": 3,
   "component": {
    "kind": "stat",
    "version": 1
   },
   "props": {
    "label": "Team members"
   },
   "bindings": {
    "value": {
     "kind": "read",
     "reader": "run",
     "result": "home",
     "pointer": "/team/size"
    },
    "sub": {
     "kind": "read",
     "reader": "run",
     "result": "home",
     "pointer": "/team/revision"
    }
   },
   "when": {
    "result": "home",
    "pointer": "/status",
    "equals": "VISIBLE"
   }
  },
  {
   "sectionId": "members",
   "regionId": "main",
   "order": 4,
   "component": {
    "kind": "card-list",
    "version": 1
   },
   "when": {
    "result": "home",
    "pointer": "/status",
    "equals": "VISIBLE"
   },
   "bindings": {
    "cards": {
     "kind": "read",
     "reader": "run",
     "result": "home",
     "pointer": "/team/members",
     "map": {
      "title": "/displayName",
      "body": "/definitionId",
      "promise": "/photoRef",
      "meta": "/encounterId"
     }
    }
   }
  },
  {
   "sectionId": "empty",
   "regionId": "main",
   "order": 5,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "info",
    "title": "No team yet",
