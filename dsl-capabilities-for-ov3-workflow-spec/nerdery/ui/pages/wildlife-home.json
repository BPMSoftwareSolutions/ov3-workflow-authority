    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "error",
    "title": "Refused by the capability"
   },
   "bindings": {
    "body": {
     "kind": "read",
     "reader": "run",
     "result": "home",
     "pointer": "/reason/code"
    }
   },
   "when": {
    "result": "home",
    "pointer": "/status",
    "equals": "REFUSED"
   }
  }
 ]
