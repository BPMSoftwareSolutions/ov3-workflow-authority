 "sources": [
  {
   "sourceId": "session",
   "reader": "session"
  }
 ],
 "sections": [
  {
   "sectionId": "hero",
   "regionId": "main",
   "order": 1,
   "component": {
    "kind": "hero",
    "version": 1
   },
   "props": {
    "eyebrow": "Capture",
    "headline": "Photograph it, then record it",
    "lede": "Upload the photo first: the slice keeps its exact bytes under their digest. Then record the encounter with that photo. Recording collects the animal for you.",
    "primaryActionId": "open-circuit"
   },
   "bindings": {
    "figure": {
     "kind": "read",
     "reader": "scenario",
     "input": {
      "capabilityId": "nerdery-record-animal-encounter",
      "namespaceId": "sidefx:capabilities",
      "page": "scenario-1"
     },
     "pointer": "/slides/0"
    }
   },
   "actions": [
    {
     "actionId": "open-circuit",
     "kind": "navigate",
     "to": "/circuit/explorer?capability=nerdery-record-animal-encounter&namespace=sidefx%3Acapabilities"
    }
   ]
  },
  {
   "sectionId": "upload-heading",
   "regionId": "main",
   "order": 2,
   "component": {
    "kind": "heading",
    "version": 1
   },
   "props": {
    "text": "1. Upload a photo",
    "level": 2
   }
  },
  {
   "sectionId": "upload",
   "regionId": "main",
   "order": 3,
   "component": {
    "kind": "form",
    "version": 1
   },
   "props": {
    "fields": [
     {
      "name": "photo",
      "label": "Photo",
      "kind": "file",
      "accept": "image/*",
      "required": true,
      "hint": "Keep it small for the demo (under 8 MB)"
     }
    ],
    "submit": "Upload photo"
   },
   "actions": [
    {
     "actionId": "upload",
     "kind": "observe",
     "subject": "nerdery-upload-encounter-photo",
     "namespace": "sidefx:capabilities",
     "result": "upload",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {
        "fileName": {
         "form": "photo",
         "as": "file-name"
        },
        "mediaType": {
         "form": "photo",
         "as": "media-type"
        },
        "contentBase64": {
         "form": "photo",
         "as": "base64"
        }
       }
      }
     }
    }
   ],
   "events": [
    {
     "on": "submit",
     "actionId": "upload"
    }
   ]
  },
  {
   "sectionId": "upload-result",
   "regionId": "main",
   "order": 4,
   "component": {
    "kind": "field-list",
    "version": 1
   },
   "props": {
    "label": "Retained photo"
   },
   "when": {
    "result": "upload",
    "pointer": "/status",
    "equals": "UPLOADED"
   },
   "bindings": {
    "fields": {
     "kind": "read",
     "reader": "run",
     "result": "upload",
     "pointer": "/photo",
     "map": {
      "Photo reference": "/photoRef",
      "Bytes": "/byteLength",
      "Content digest": "/contentSha256",
      "Durable": "/durable",
      "Verified now": "/verificationPerformed"
     }
    }
   }
  },
  {
   "sectionId": "upload-refused",
   "regionId": "main",
   "order": 5,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "error",
    "title": "Refused by the capability"
   },
   "bindings": {
    "body": {
     "kind": "read",
     "reader": "run",
     "result": "upload",
     "pointer": "/reason/code"
    }
   },
   "when": {
    "result": "upload",
    "pointer": "/status",
    "equals": "REFUSED"
   }
  },
  {
   "sectionId": "record-heading",
   "regionId": "main",
   "order": 6,
   "component": {
    "kind": "heading",
    "version": 1
   },
   "props": {
    "text": "2. Record the encounter",
    "level": 2
   }
  },
  {
   "sectionId": "record",
   "regionId": "main",
   "order": 7,
   "component": {
    "kind": "form",
    "version": 1
   },
   "props": {
    "fields": [
     {
      "name": "encounterId",
      "label": "Encounter id (one per individual; the same id and content again replays)",
      "value": "enc-interview-1"
     },
     {
      "name": "definitionId",
      "label": "Animal",
      "kind": "select",
      "options": [
       {
        "value": "animal-001",
        "label": "No. 001 Demo Heron"
       },
       {
        "value": "animal-002",
        "label": "No. 002 Demo Fox"
       },
       {
        "value": "animal-003",
        "label": "No. 003 Demo Beetle"
       }
      ],
      "value": "animal-001"
     },
     {
      "name": "place",
      "label": "Where you saw it",
      "value": "Synthetic park, north path"
     },
     {
      "name": "nickname",
      "label": "Nickname (optional)",
      "value": "Reed"
     },
     {
      "name": "photoRef",
      "label": "Photo reference (filled in from the upload above)",
      "required": true
     }
    ],
    "submit": "Record encounter"
   },
   "bindings": {
    "values": {
     "kind": "read",
     "reader": "run",
     "result": "upload",
     "pointer": "/photo"
    }
   },
   "actions": [
    {
     "actionId": "record",
     "kind": "observe",
     "subject": "nerdery-record-animal-encounter",
     "namespace": "sidefx:capabilities",
     "result": "record",
     "input": {
      "input": {
       "caller": {
        "principalId": {
         "source": "session",
         "pointer": "/principalId"
        },
        "sessionId": {
         "source": "session",
         "pointer": "/sessionId"
        }
       },
       "request": {
        "encounterId": {
         "form": "encounterId"
        },
        "definitionId": {
         "form": "definitionId"
        },
        "location": {
         "source": "manual",
         "description": {
          "form": "place"
         }
        },
        "photoRef": {
         "form": "photoRef"
        },
        "nickname": {
         "form": "nickname",
         "optional": true
        }
       }
      }
     }
    }
   ],
   "events": [
    {
     "on": "submit",
     "actionId": "record"
    }
   ]
  },
  {
   "sectionId": "record-result",
   "regionId": "main",
   "order": 8,
   "component": {
    "kind": "field-list",
    "version": 1
   },
   "props": {
    "label": "Recorded"
   },
   "when": {
    "result": "record",
    "pointer": "/status",
    "equals": "RECORDED"
   },
   "bindings": {
    "fields": {
     "kind": "read",
     "reader": "run",
     "result": "record",
     "pointer": "",
     "map": {
      "Encounter": "/encounter/encounterId",
      "Animal": "/encounter/definitionId",
      "Nickname": "/encounter/nickname",
      "Where": "/encounter/location/description",
      "Your collection": "/collectionState",
      "Photo verified": "/verificationPerformed",
      "Replayed": "/replayed"
     }
    }
   }
  },
  {
   "sectionId": "record-replayed",
   "regionId": "main",
   "order": 9,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "info",
    "title": "Replayed, not written twice",
    "body": "The same encounter id and content were submitted again. The capability returned the original record and wrote nothing new."
   },
   "when": {
    "result": "record",
    "pointer": "/replayed",
    "equals": true
   }
  },
  {
   "sectionId": "record-refused",
   "regionId": "main",
   "order": 10,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "error",
    "title": "Refused by the capability"
   },
   "bindings": {
    "body": {
     "kind": "read",
     "reader": "run",
     "result": "record",
     "pointer": "/reason/code"
    }
   },
   "when": {
    "result": "record",
    "pointer": "/status",
    "equals": "REFUSED"
   }
  },
  {
   "sectionId": "record-next",
   "regionId": "main",
   "order": 11,
   "component": {
    "kind": "notice",
    "version": 1
   },
   "props": {
    "tone": "info",
    "title": "Collected",
    "body": "Open the animal again: its locked fields are now yours.",
    "actionId": "go-animal"
   },
   "actions": [
    {
     "actionId": "go-animal",
     "kind": "navigate",
     "to": "/circuit/wildlife-animal"
    }
   ],
   "when": {
    "result": "record",
    "pointer": "/status",
    "equals": "RECORDED"
   }
  }
 ]
}
