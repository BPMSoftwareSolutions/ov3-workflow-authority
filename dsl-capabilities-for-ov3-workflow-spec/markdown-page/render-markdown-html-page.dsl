capability render-markdown-html-page
feature render-markdown-html-page sha256:de3321b96b992f0c0231bfa08b03e8dee3ece35c49b67d9b6056116f10079284
intent: Render Markdown text or a retained Markdown digest to a complete styled standalone HTML page using the approved Python-Markdown and nh3 presentation profile. Publish the HTML and verify the source and output digests.
outcome: A verified published UTF-8 HTML document and compact content, source, renderer and publication receipt.
inquiry: Render Markdown text or a retained Markdown digest to a complete styled standalone HTML page using the approved Python-Markdown and nh3 presentation profile. Publish the HTML and verify the source and output digests.
input contract render-markdown-html-page-request.v1 {"type":"object","properties":{"markdown":{"type":"string","minLength":1,"maxLength":2097152},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"title":{"type":"string","minLength":1,"maxLength":200},"lang":{"type":"string","pattern":"^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"},"profile":{"const":"technical-report-v1"},"filename":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,95}\\.html$"}},"required":["title","lang","profile","filename"],"additionalProperties":false,"oneOf":[{"required":["markdown"]},{"required":["sourceDigest"]}]}
output contract markdown-page-publication.v1 {"type":"object","required":["status","contractId","contentDigest","sourceDigest","inputDigest","bundleDigest","profileDigest","filename","renderer","verification"],"properties":{"contractId":{"const":"markdown-page-publication.v1"},"status":{"const":"COMPLETE"},"contentDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"sourceDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"inputDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"bundleDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"profileDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"filename":{"type":"string"},"renderer":{"type":"object"},"verification":{"type":"object"}},"additionalProperties":true}
cli display outcome as json
scenario render-markdown-html-page root terminal
variants: COMPLETE:success
given: a UTF-8 Markdown source or retained digest, page metadata and an approved presentation profile
when: SideFX resolves the pinned Python parser and sanitizer, assembles the page and publishes its UTF-8 bytes
then: the receipt binds the source, renderer, presentation profile and independently verified published page
operation render-markdown-html-page.source uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @source nvarchar(max)=(SELECT value FROM OPENJSON(@input) WHERE [key]='markdown' AND type=1); DECLARE @digest varchar(71)=JSON_VALUE(@input,'$.sourceDigest'); IF (SELECT COUNT(*) FROM OPENJSON(@input) WHERE [key] IN ('markdown','sourceDigest'))<>1 THROW 51000,'EXACTLY_ONE_MARKDOWN_SOURCE_REQUIRED',1; IF @source IS NULL BEGIN DECLARE @raw TABLE(bytes varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @raw SELECT TOP(1) c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON c.content_digest=a.content_digest WHERE a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@digest,8,64),2) AND a.content_digest=HASHBYTES('SHA2_256',c.content_bytes) AND (a.artifact_kind LIKE N'python-library-report:%' OR a.artifact_kind=N'markdown-page-source') AND DATALENGTH(c.content_bytes) BETWEEN 1 AND 2097152; SELECT @source=CONVERT(nvarchar(max),bytes) FROM @raw; END; IF @source IS NULL OR DATALENGTH(CONVERT(varchar(max),@source COLLATE Latin1_General_100_BIN2_UTF8)) NOT BETWEEN 1 AND 2097152 THROW 51000,'MARKDOWN_SOURCE_NOT_RESOLVED',1; IF ISNULL(JSON_VALUE(@input,'$.profile'),'')<>'technical-report-v1' THROW 51000,'UNKNOWN_PRESENTATION_PROFILE',1; DECLARE @request nvarchar(max)=JSON_MODIFY(JSON_MODIFY(@input,'$.sourceDigest',NULL),'$.markdown',@source); SELECT (SELECT 'content-artifact-change.v1' contractId,'markdown-page-input' artifactKind,@request [text], 'read-harness-authoring-state' verificationCapabilityId,JSON_QUERY(N'{\"resolvedDisposition\":\"terminated\"}') route, JSON_QUERY(N'{\"input\":{\"changeKind\":\"content-artifact-change\",\"includeDefinitions\":true},\"expected\":{\"disposition\":\"terminated\"}}') preflight FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) value;"}
input input from render-markdown-html-page $
operation render-markdown-html-page.retain-source uses provider apply-declared-change
config: {"contractId":"declared-change.v1","changeKind":"content-artifact-change"}
input payload from render-markdown-html-page.source $.value
operation render-markdown-html-page.load-render uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @asset varchar(71)='sha256:c4158d9856a0a8a406175f374cc4edb15ee87f94cf660cdee315a6498c566c7f',@phase varchar(10)='render'; DECLARE @returned nvarchar(max)=COALESCE(JSON_VALUE(@input,'$.result[0][0].value'),JSON_QUERY(@input,'$.result[0][0]')); DECLARE @storedDigest varchar(71)=JSON_VALUE(@returned,'$.content_digest'),@kind nvarchar(200)=JSON_VALUE(@returned,'$.artifact_kind'); IF ISNULL(JSON_VALUE(@input,'$.disposition'),'')<>'COMMITTED' OR @storedDigest IS NULL THROW 51000,'PUBLICATION_WRITE_FAILED',1; DECLARE @package TABLE(bytes varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @package SELECT TOP(1) c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON c.content_digest=a.content_digest WHERE a.artifact_kind=N'markdown-python-provider-package' AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@asset,8,64),2) AND a.content_digest=HASHBYTES('SHA2_256',c.content_bytes); DECLARE @bundle varchar(max)=(SELECT bytes FROM @package); IF @bundle IS NULL THROW 51000,'PINNED_PACKAGE_NOT_PRESENT',1; DECLARE @inputHash varchar(71)=CASE WHEN @phase='render' AND @kind='markdown-page-input' THEN @storedDigest WHEN @phase='verify' AND LEN(@kind)=78 AND LEFT(@kind,14)='markdown-page:' THEN 'sha256:'+SUBSTRING(@kind,15,64) END; DECLARE @documents TABLE(kind nvarchar(200),bytes varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @documents SELECT a.artifact_kind,c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON c.content_digest=a.content_digest WHERE ((a.artifact_kind='markdown-page-input' AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@inputHash,8,64),2)) OR (@phase='verify' AND a.artifact_kind=@kind AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@storedDigest,8,64),2))) AND a.content_digest=HASHBYTES('SHA2_256',c.content_bytes); DECLARE @request nvarchar(max)=(SELECT TOP(1) CONVERT(nvarchar(max),bytes) FROM @documents WHERE kind='markdown-page-input'); DECLARE @html nvarchar(max)=(SELECT TOP(1) CONVERT(nvarchar(max),bytes) FROM @documents WHERE kind=@kind AND @phase='verify'); IF @request IS NULL OR (@phase='verify' AND @html IS NULL) THROW 51000,'PAGE_AND_SOURCE_BINDING_MISSING',1; DECLARE @source nvarchar(max)=(SELECT value FROM OPENJSON(@request) WHERE [key]='markdown' AND type=1); DECLARE @sourceDigest varchar(71)='sha256:'+LOWER(CONVERT(varchar(64),HASHBYTES('SHA2_256',CONVERT(varchar(max),@source COLLATE Latin1_General_100_BIN2_UTF8)),2)); SELECT (SELECT @phase phase,@bundle bundle,@inputHash inputDigest,JSON_QUERY(@request) request,COALESCE(@html,N'') html, JSON_QUERY((SELECT @sourceDigest sourceDigest,@storedDigest outputDigest FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) receipt FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) value;"}
input input from render-markdown-html-page.retain-source $
operation render-markdown-html-page.render uses provider python-markdown-page-operation
input phase from render-markdown-html-page.load-render $.value.phase
input bundle from render-markdown-html-page.load-render $.value.bundle
input inputDigest from render-markdown-html-page.load-render $.value.inputDigest
input request from render-markdown-html-page.load-render $.value.request
input html from render-markdown-html-page.load-render $.value.html
input receipt from render-markdown-html-page.load-render $.value.receipt
operation render-markdown-html-page.publication uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @page nvarchar(max)=(SELECT value FROM OPENJSON(@input) WHERE [key]='html' AND type=1),@inputDigest varchar(71)=JSON_VALUE(@input,'$.inputDigest'); IF ISNULL(JSON_VALUE(@input,'$.status'),'')<>'RENDERED' OR LEN(ISNULL(@inputDigest,''))<>71 OR @page IS NULL OR ISNULL(JSON_VALUE(@input,'$.outputDigest'),'')<>'sha256:'+LOWER(CONVERT(varchar(64),HASHBYTES('SHA2_256',CONVERT(varchar(max),@page COLLATE Latin1_General_100_BIN2_UTF8)),2)) THROW 51000,'PYTHON_RENDER_FAILED',1; SELECT (SELECT 'content-artifact-change.v1' contractId,'markdown-page:'+SUBSTRING(@inputDigest,8,64) artifactKind,@page [text], 'read-harness-authoring-state' verificationCapabilityId,JSON_QUERY(N'{\"resolvedDisposition\":\"terminated\"}') route, JSON_QUERY(N'{\"input\":{\"changeKind\":\"content-artifact-change\",\"includeDefinitions\":true},\"expected\":{\"disposition\":\"terminated\"}}') preflight FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) value;"}
input input from render-markdown-html-page.render $
operation render-markdown-html-page.publish uses provider apply-declared-change
config: {"contractId":"declared-change.v1","changeKind":"content-artifact-change"}
input payload from render-markdown-html-page.publication $.value
operation render-markdown-html-page.read-publication uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"DECLARE @asset varchar(71)='sha256:c4158d9856a0a8a406175f374cc4edb15ee87f94cf660cdee315a6498c566c7f',@phase varchar(10)='verify'; DECLARE @returned nvarchar(max)=COALESCE(JSON_VALUE(@input,'$.result[0][0].value'),JSON_QUERY(@input,'$.result[0][0]')); DECLARE @storedDigest varchar(71)=JSON_VALUE(@returned,'$.content_digest'),@kind nvarchar(200)=JSON_VALUE(@returned,'$.artifact_kind'); IF ISNULL(JSON_VALUE(@input,'$.disposition'),'')<>'COMMITTED' OR @storedDigest IS NULL THROW 51000,'PUBLICATION_WRITE_FAILED',1; DECLARE @package TABLE(bytes varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @package SELECT TOP(1) c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON c.content_digest=a.content_digest WHERE a.artifact_kind=N'markdown-python-provider-package' AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@asset,8,64),2) AND a.content_digest=HASHBYTES('SHA2_256',c.content_bytes); DECLARE @bundle varchar(max)=(SELECT bytes FROM @package); IF @bundle IS NULL THROW 51000,'PINNED_PACKAGE_NOT_PRESENT',1; DECLARE @inputHash varchar(71)=CASE WHEN @phase='render' AND @kind='markdown-page-input' THEN @storedDigest WHEN @phase='verify' AND LEN(@kind)=78 AND LEFT(@kind,14)='markdown-page:' THEN 'sha256:'+SUBSTRING(@kind,15,64) END; DECLARE @documents TABLE(kind nvarchar(200),bytes varchar(max) COLLATE Latin1_General_100_BIN2_UTF8); INSERT @documents SELECT a.artifact_kind,c.content_bytes FROM model.content_artifact a JOIN source.content_object c ON c.content_digest=a.content_digest WHERE ((a.artifact_kind='markdown-page-input' AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@inputHash,8,64),2)) OR (@phase='verify' AND a.artifact_kind=@kind AND a.content_digest=TRY_CONVERT(binary(32),SUBSTRING(@storedDigest,8,64),2))) AND a.content_digest=HASHBYTES('SHA2_256',c.content_bytes); DECLARE @request nvarchar(max)=(SELECT TOP(1) CONVERT(nvarchar(max),bytes) FROM @documents WHERE kind='markdown-page-input'); DECLARE @html nvarchar(max)=(SELECT TOP(1) CONVERT(nvarchar(max),bytes) FROM @documents WHERE kind=@kind AND @phase='verify'); IF @request IS NULL OR (@phase='verify' AND @html IS NULL) THROW 51000,'PAGE_AND_SOURCE_BINDING_MISSING',1; DECLARE @source nvarchar(max)=(SELECT value FROM OPENJSON(@request) WHERE [key]='markdown' AND type=1); DECLARE @sourceDigest varchar(71)='sha256:'+LOWER(CONVERT(varchar(64),HASHBYTES('SHA2_256',CONVERT(varchar(max),@source COLLATE Latin1_General_100_BIN2_UTF8)),2)); SELECT (SELECT @phase phase,@bundle bundle,@inputHash inputDigest,JSON_QUERY(@request) request,COALESCE(@html,N'') html, JSON_QUERY((SELECT @sourceDigest sourceDigest,@storedDigest outputDigest FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)) receipt FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) value;"}
input input from render-markdown-html-page.publish $
operation render-markdown-html-page.verify uses provider python-markdown-page-operation
input phase from render-markdown-html-page.read-publication $.value.phase
input bundle from render-markdown-html-page.read-publication $.value.bundle
input inputDigest from render-markdown-html-page.read-publication $.value.inputDigest
input request from render-markdown-html-page.read-publication $.value.request
input html from render-markdown-html-page.read-publication $.value.html
input receipt from render-markdown-html-page.read-publication $.value.receipt
operation render-markdown-html-page.finish uses provider sql-database-reader
config: {"dataSource":"sfx-estate-database","resultColumn":"value","statement":"IF ISNULL(JSON_VALUE(@input,'$.status'),'')<>'VERIFIED' OR ISNULL(JSON_VALUE(@input,'$.bundleDigest'),'')<>'sha256:e8509955c60edda2c332a2330b3add907aeba1e8f27896fd29ee147fedf3e078' OR ISNULL(JSON_VALUE(@input,'$.profileDigest'),'')<>'sha256:b78adad4d2c8a338635a89866558b574bdc39c7ef48c34f3e25dfa4f0ae1a30c' THROW 51000,'INDEPENDENT_HTML_CHECK_FAILED',1; SELECT (SELECT 'markdown-page-publication.v1' contractId,'COMPLETE' status,JSON_VALUE(@input,'$.outputDigest') contentDigest, JSON_VALUE(@input,'$.sourceDigest') sourceDigest,JSON_VALUE(@input,'$.inputDigest') inputDigest,JSON_VALUE(@input,'$.bundleDigest') bundleDigest, JSON_VALUE(@input,'$.profileDigest') profileDigest,JSON_VALUE(@input,'$.filename') filename,JSON_QUERY(@input,'$.renderer') renderer, JSON_QUERY(@input) verification FOR JSON PATH,WITHOUT_ARRAY_WRAPPER) value;"}
input input from render-markdown-html-page.verify $
outcome from render-markdown-html-page.finish $.value
