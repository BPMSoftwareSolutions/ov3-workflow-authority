{
  "id": "technical-report-v1",
  "allowedTags": [
    "a",
    "blockquote",
    "br",
    "code",
    "del",
    "em",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "li",
    "ol",
    "p",
    "pre",
    "strong",
    "table",
    "tbody",
    "td",
    "th",
    "thead",
    "tr",
    "ul"
  ],
  "codeClasses": [
    "language-bash",
    "language-css",
    "language-html",
    "language-javascript",
    "language-json",
    "language-python",
    "language-sql",
    "language-text"
  ],
  "csp": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'",
  "css": ":root{font:17px/1.6 system-ui,sans-serif;color:#182536;background:#fbfaf7}body{margin:0}header,main{max-width:78rem;margin:auto;padding:1.6rem clamp(1.2rem,4vw,3rem)}header{border-bottom:2px solid #236563}header strong{font-size:1.25rem}main{display:grid;grid-template-columns:minmax(12rem,18rem) minmax(0,1fr);gap:3rem}nav{font-size:.88rem;max-height:85vh;overflow:auto;position:sticky;top:1rem;align-self:start}nav ol{padding-left:1.5rem}article{min-width:0;overflow-wrap:anywhere}h1,h2,h3{line-height:1.2}h2{border-top:1px solid #bacbc8;padding-top:1.2rem}a{color:#0d5e67;overflow-wrap:anywhere}pre{overflow:auto;background:#182536;color:#f3f8f8;padding:1rem;border-radius:.35rem}code{font: .88em/1.5 ui-monospace,monospace}table{border-collapse:collapse;display:block;overflow:auto}th,td{border:1px solid #bccbc8;text-align:left;padding:.4rem .7rem}th{background:#e5eeeb}@media(max-width:54rem){main{display:block}nav{position:static;max-height:14rem;margin-bottom:2rem}}@media print{nav{display:none}main{display:block}pre{white-space:pre-wrap}}",
  "markdownConventions": [
    "literal-double-underscore-identifiers",
    "lists-after-bold-labels"
  ]
}
